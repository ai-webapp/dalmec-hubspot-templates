            "name": "main_dnd-module-3",
            "params": {
              "anchor_id": "",
              "eyebrow": "Why GOLD",
              "titolo_sezione": "Designed around the details that make the difference in the kitchen.",
              "rows": [
                {
                  "bullet": [
                    {
                      "testo": "Seven-chamber magnetic gasket, easy to remove"
                    },
                    {
                      "testo": "Removable AISI 304 stainless steel tray rack"
                    }
                  ],
                  "immagine": {
                    "alt": "Immagine ChatGPT 3 ott 2026, 17_59_57-3",
                    "height": 1254,
                    "src": "https://2662982.fs1.hubspotusercontent-na1.net/hubfs/2662982/Immagine%20ChatGPT%203%20ott%202026%2c%2017_59_57-3.png",
                    "width": 1254
                  },
                  "testo": "<p>The cataphoresis-coated evaporator is reached by opening the fan door from inside the chamber. Fewer residues, better hygiene, no technician required.</p>",
                  "titolo": "Cleans in minutes, with no tools."
                },
                {
                  "bullet": [
                    {
                      "testo": "Dual format: Gastronorm and Euronorm"
                    },
                    {
                      "testo": "Adjustable AISI 304 stainless steel feet"
                    }
                  ],
                  "immagine": {
                    "alt": "Immagine ChatGPT 3 ott 2026, 17_59_58-4",
                    "height": 1254,
                    "src": "https://2662982.fs1.hubspotusercontent-na1.net/hubfs/2662982/Immagine%20ChatGPT%203%20ott%202026%2c%2017_59_58-4.png",
                    "width": 1254
                  },
                  "testo": "<p>Holds GN 1/1 or EN 600×400 trays in a 820 × 860 mm footprint. Pastry-blast-chiller capacity in a professional kitchen footprint.</p>",
                  "titolo": "10 trays in less than one square metre."
                },
                {
                  "bullet": [
                    {
                      "testo": "End of cycle by temperature or by time"
                    },
                    {
                      "testo": "Heated core probe available as an accessory"
                    }
                  ],
                  "immagine": {
                    "alt": "Immagine ChatGPT 3 ott 2026, 17_59_56-1",
                    "height": 1254,
                    "src": "https://2662982.fs1.hubspotusercontent-na1.net/hubfs/2662982/Immagine%20ChatGPT%203%20ott%202026%2c%2017_59_56-1.png",
                    "width": 1254
                  },
                  "testo": "<p>7\" capacitive touch display on the door front. Chill or freeze, by core temperature or by time: set the cycle in one gesture.</p>",
                  "titolo": "One touch to choose the right cycle."
                },
                {
                  "bullet": [
                    {
                      "testo": "Low-GWP R455a refrigerant"
                    },
                    {
                      "testo": "Cabinet temperature from −40 to +10 °C"
                    }
                  ],
                  "immagine": {
                    "alt": "Immagine ChatGPT 3 ott 2026, 17_59_57-2",
                    "height": 1254,
                    "src": "https://2662982.fs1.hubspotusercontent-na1.net/hubfs/2662982/Immagine%20ChatGPT%203%20ott%202026%2c%2017_59_57-2.png",
                    "width": 1254
                  },
                  "testo": "<p>60 mm insulation and a door with automatic closing and fixed 100° opening. Stable temperature, fine ice crystals, texture and flavour preserved.</p>",
                  "titolo": "The cold stays in. So does the quality."
                }
              ],
